# gemini (default) | groq | anthropic
LLM_PROVIDER=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional model override for the chosen provider
LLM_MODEL=
ANTHROPIC_API_KEY=
# Optional Anthropic-only override; defaults to claude-haiku-5-5
ANTHROPIC_MODEL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
VERIFY_TOKEN=
ADMIN_PASSWORD=
ORDERBOT_DB=
# Optional: owner's WhatsApp number (digits only, e.g. 15551234567) to alert on each new order.
# See the "Owner alerts" section in docs/whatsapp-setup.md for the 24-hour messaging rule.
OWNER_WHATSAPP_NUMBER=
